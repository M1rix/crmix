# Core database/runtime
POSTGRES_ADMIN_PASSWORD=replace-with-long-random-admin-password
DB_PASSWORD=replace-with-long-random-app-password
JWT_SECRET=replace-with-at-least-32-random-bytes
SPRING_PROFILES_ACTIVE=local
APP_CORS_ALLOWED_ORIGINS=https://crm.example.com
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8088

# Telegram reminders and support
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
SUPPORT_TELEGRAM_CHAT_ID=

# Payme
PAYME_LOGIN=Paycom
PAYME_SECRET=
PAYME_MERCHANT_ID=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
PAYME_CALLBACK_URL=https://crm.example.com/billing

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-long-random-password
GRAFANA_BIND_ADDRESS=127.0.0.1
GRAFANA_PORT=3000

# Host backup scripts
BACKUP_DIR=/var/backups/crmix
BACKUP_RETENTION_DAYS=7
BACKUP_S3_URI=s3://company-crmix-backups/prod
